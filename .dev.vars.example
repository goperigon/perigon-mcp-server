# Copy to .dev.vars for local `wrangler dev`. .dev.vars is gitignored.

# OAuth discovery + upstream API (see wrangler.jsonc vars for defaults).
MCP_PUBLIC_URL=http://127.0.0.1:8787
PERIGON_API_URL=http://localhost:8080
PERIGON_APP_URL=http://localhost:3000

# Any non-empty value passes the startup check; a real key is only needed for /v1/api/chat.
ANTHROPIC_API_KEY=
